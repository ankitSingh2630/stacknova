# Set these manually in Appwrite Function settings, then redeploy.
# Appwrite authentication uses the runtime key; Resend needs its own secret below.
# Never copy these settings into NEXT_PUBLIC_* or commit a populated env file.
DATABASE_ID=
LEADS_TABLE_ID=
ALLOWED_ORIGINS=http://localhost:3000
# When serving production, explicitly include its approved HTTPS origins; never use *.
RESEND_API_KEY=
# Single bare addresses only: no display names, lists, whitespace, or controls.
RESEND_FROM_EMAIL=
STACKNOVA_LEADS_EMAIL=
